    {
        "id": "8a019ee2ce0d1fcb",
        "type": "ui_template",
        "z": "a2e35f0de4403da7",
        "g": "d8cb26a76ec1c0d0",
        "group": "2d0a912acafce1f6",
        "name": "shelly powerstrip",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<div class=\"powerstrip\">\n\n    <div class=\"socket\" ng-repeat=\"n in [1,2,3,4]\" ng-class=\"{'on': plugs['plug'+n]}\" ng-click=\"toggle(n)\">\n    \n        <div class=\"led\"></div>\n    \n        <div class=\"socket-face\">\n            <div class=\"hole left\"></div>\n            <div class=\"hole right\"></div>\n        </div>\n    \n        <div class=\"label\">\n            Plug {{n}}<br>\n            {{plugs['plug'+n] ? 'ON' : 'OFF'}}\n        </div>\n    \n    </div>\n\n</div>\n\n<style>\n.powerstrip {\n    display:flex;\n    justify-content:space-around;\n    align-items:center;\n\n    padding:20px;\n    margin:10px;\n\n    background:linear-gradient(to bottom,#f5f5f5,#d9d9d9);\n    border-radius:20px;\n\n    border:2px solid #aaa;\n    box-shadow:\n        inset 0 2px 5px rgba(255,255,255,0.8),\n        inset 0 -2px 5px rgba(0,0,0,0.15),\n        0 3px 8px rgba(0,0,0,0.25);\n}\n\n.socket {\n    width:90px;\n    height:120px;\n\n    border-radius:15px;\n    background:#ececec;\n\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n\n    cursor:pointer;\n\n    transition:all 0.2s ease;\n    position:relative;\n}\n\n.socket:hover {\n    transform:translateY(-2px);\n}\n\n.socket:active {\n    transform:translateY(1px);\n}\n\n.socket-face {\n    width:60px;\n    height:60px;\n    border-radius:50%;\n\n    background:#d0d0d0;\n\n    display:flex;\n    justify-content:center;\n    align-items:center;\n\n    position:relative;\n\n    box-shadow:\n        inset 0 2px 4px rgba(255,255,255,0.7),\n        inset 0 -2px 4px rgba(0,0,0,0.15);\n}\n\n.hole {\n    width:10px;\n    height:10px;\n\n    background:#222;\n    border-radius:50%;\n\n    position:absolute;\n    top:25px;\n}\n\n.hole.left {\n    left:18px;\n}\n\n.hole.right {\n    right:18px;\n}\n\n.led {\n    width:12px;\n    height:12px;\n    border-radius:50%;\n\n    background:#555;\n    margin-bottom:10px;\n\n    box-shadow:0 0 2px rgba(0,0,0,0.5);\n}\n\n.socket.on .led {\n    background:#00ff00;\n    box-shadow:\n        0 0 5px #00ff00,\n        0 0 10px #00ff00,\n        0 0 20px #00ff00;\n}\n\n.label {\n    margin-top:10px;\n    font-size:12px;\n    font-weight:bold;\n    color:#444;\n}\n</style>\n\n<script>\n(function(scope) {\n\n    // initial stable state\n    scope.plugs = {\n        plug1: false,\n        plug2: false,\n        plug3: false,\n        plug4: false\n    };\n\n    // send toggle command on click\n    scope.toggle = function(plug) {\n        scope.send({\n            payload: {\n                plug: plug,\n                action: \"toggle\"\n            }\n        });\n    };\n\n    // update only changed keys (no flicker)\n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload) return;\n\n        var p = msg.payload;\n\n        if (p.plug1 !== undefined) scope.plugs.plug1 = !!p.plug1;\n        if (p.plug2 !== undefined) scope.plugs.plug2 = !!p.plug2;\n        if (p.plug3 !== undefined) scope.plugs.plug3 = !!p.plug3;\n        if (p.plug4 !== undefined) scope.plugs.plug4 = !!p.plug4;\n    });\n\n})(scope);\n</script>",
        "storeOutMessages": true,
