        "name": "Extract vibration data and send 2 graph",
        "func": "// Extract RMS values from incoming payload\nconst x = msg.payload.PD_ProcessData.Value_0__default__v_RMS__X_;\nconst y = msg.payload.PD_ProcessData.Value_1__default__v_RMS__Y_;\nconst z = msg.payload.PD_ProcessData.Value_2__default__v_RMS__Z_;\n\n// Only continue if all 3 values are available\nif (x != null && y != null && z != null) {\n\n    return [[\n        {\n            topic: \"RMS_X\",\n            payload: x\n        },\n        {\n            topic: \"RMS_Y\",\n            payload: y\n        },\n        {\n            topic: \"RMS_Z\",\n            payload: z\n        }\n    ]];\n}\n",
